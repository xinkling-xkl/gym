<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gym.mapper.AdminMapper">
    <select id="getAdminByAccount" resultType="com.gym.entity.Admin">
        SELECT * FROM admin WHERE admin_account = #{adminAccount}
    </select>

    <insert id="addAdmin" parameterType="com.gym.entity.Admin">
        INSERT INTO admin (admin_account, admin_password)
        VALUES (#{adminAccount}, #{adminPassword})
    </insert>

    <update id="updateAdmin" parameterType="com.gym.entity.Admin">
        UPDATE admin SET
        admin_password = #{adminPassword}
        WHERE admin_account = #{adminAccount}
    </update>

    <delete id="deleteAdmin">
        DELETE FROM admin WHERE admin_account = #{adminAccount}
    </delete>
</mapper>
